@{
    ViewData["Title"] = "Account Login";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card mt-5 shadow-lg border-0">
            <div class="card-header text-center py-4">
                <h2 class="text-uppercase tracking-wider">Access Your Fund</h2>
                <p class="text-muted small">Enter your secure credentials</p>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label class="form-label">Card Number</label>
                        <input type="text" name="cardNumber" class="form-control" required maxlength="16" placeholder="16-digit card number" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">PIN</label>
                        <input type="password" name="pin" class="form-control" required maxlength="4" placeholder="4-digit PIN" />
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">Login</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
