<div class="hero-section text-center py-5 my-5">
    <div class="container">
        <h1 class="display-3 fw-bold mb-4 tracking-tight">ELEVATE YOUR BANKING</h1>
        <p class="lead text-muted mb-5 mx-auto w-75">Experience the future of secure financial management at Booker University. Seamless, transparent, and built for you.</p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5 py-3 h6">GET STARTED</a>
            <a asp-controller="Admin" asp-action="Login" class="btn btn-outline-info btn-lg px-5 py-3 h6">ADMIN PORTAL</a>
        </div>
    </div>
</div>

<div class="row mt-5 pt-5 text-center">
    <div class="col-md-4">
        <div class="card p-4 h-100">
            <h5 class="text-accent-blue">SECURE</h5>
            <p class="text-muted small">Military-grade encryption for all transactions.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 h-100">
            <h5 class="text-accent-blue">FAST</h5>
            <p class="text-muted small">Instant fund access and real-time updates.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 h-100">
            <h5 class="text-accent-blue">UNIVERSAL</h5>
            <p class="text-muted small">Access your account from any campus terminal.</p>
        </div>
    </div>
</div>
