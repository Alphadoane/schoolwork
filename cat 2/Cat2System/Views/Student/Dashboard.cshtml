@model List<Cat2System.Models.Student>
@{
    ViewData["Title"] = "Student Results Dashboard";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4">Student Results System</h1>
        <p class="lead">Search for student results slips</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <form asp-action="Dashboard" method="get" class="mb-4">
                <div class="input-group input-group-lg shadow-sm">
                    <input type="text" name="q" value="@ViewBag.Query" class="form-control" placeholder="Search by Registration Number or Name..." />
                    <button class="btn btn-primary" type="submit">Search</button>
                </div>
            </form>

            @if (Model != null && Model.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-light">Search Results</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var student in Model)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@student.FullName</strong> <br />
                                    <small class="text-muted">@student.RegistrationNumber - @student.Program?.Name</small>
                                </div>
                                <a asp-action="ResultSlip" asp-route-regNumber="@student.RegistrationNumber" class="btn btn-outline-primary btn-sm">View Result Slip</a>
                            </li>
                        }
                    </ul>
                </div>
            }
            else if (!string.IsNullOrEmpty(ViewBag.Query))
            {
                <div class="alert alert-info">No students found matching "@ViewBag.Query"</div>
            }
        </div>
    </div>
</div>
