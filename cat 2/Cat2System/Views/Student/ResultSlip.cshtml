@model Cat2System.Models.Student
@{
    ViewData["Title"] = "Result Slip";
    var selectedSession = ViewBag.SelectedSession as Cat2System.Models.ExamSession;
    var results = ViewBag.Results as List<Cat2System.Models.Result>;
    var gpa = (double)ViewBag.GPA;
}

<div class="container mt-4">
    <div class="d-print-none mb-4 d-flex justify-content-between align-items-center">
        <a asp-action="Dashboard" class="btn btn-secondary">&larr; Back to Search</a>
        <button onclick="window.print()" class="btn btn-info text-white">Print Result Slip</button>
    </div>

    <div class="card shadow-lg border-0 p-5 mb-5 bg-white rounded-4">
        <div class="text-center mb-5 pb-4 border-bottom">
            <h1 class="display-5 fw-bold text-indigo mb-0">BOOKER UNIVERSITY</h1>
            <p class="text-uppercase tracking-widest text-muted small fw-semibold">Office of the Registrar (Academics)</p>
            <h3 class="mt-4 fw-bold">OFFICIAL RESULT SLIP</h3>
            
            <div class="row text-start mt-5 g-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3">
                        <p class="mb-1 text-muted small text-uppercase">Student Name</p>
                        <p class="h5 fw-bold mb-0">@Model.FullName</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3">
                        <p class="mb-1 text-muted small text-uppercase">Registration Number</p>
                        <p class="h5 fw-bold mb-0">@Model.RegistrationNumber</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3">
                        <p class="mb-1 text-muted small text-uppercase">Faculty</p>
                        <p class="fw-semibold mb-0">@Model.Program?.Faculty?.Name</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3">
                        <p class="mb-1 text-muted small text-uppercase">Academic Program</p>
                        <p class="fw-semibold mb-0">@Model.Program?.Name</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-4">
            <form asp-action="ResultSlip" method="get" class="row g-3 d-print-none">
                <input type="hidden" name="regNumber" value="@Model.RegistrationNumber" />
                <div class="col-auto">
                    <label class="col-form-label">Select Session:</label>
                </div>
                <div class="col-auto">
                    <select name="sessionId" class="form-select" onchange="this.form.submit()">
                        @foreach (var session in (List<Cat2System.Models.ExamSession>)ViewBag.Sessions)
                        {
                            <!option value="@session.Id" @(selectedSession?.Id == session.Id ? "selected" : "")>@session.Name</!option>
                        }
                    </select>
                </div>
            </form>
        </div>

        @if (selectedSession != null)
        {
            <h5 class="mb-3">Examination Results for: <strong>@selectedSession.Name</strong></h5>
            <table class="table table-bordered">
                <thead class="bg-light">
                    <tr>
                        <th>Unit Code</th>
                        <th>Unit Title</th>
                        <th>Hours</th>
                        <th>CAT (30)</th>
                        <th>Exam (70)</th>
                        <th>Total</th>
                        <th>Grade</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var res in results!)
                    {
                        <tr>
                            <td>@res.Unit?.Code</td>
                            <td>@res.Unit?.Name</td>
                            <td>@res.Unit?.CreditHours</td>
                            <td>@res.CatScore</td>
                            <td>@res.ExamScore</td>
                            <td><strong>@res.TotalScore</strong></td>
                            <td>@res.Grade</td>
                            <td><span class="text-@(res.Status == "PASS" ? "success" : "danger")">@res.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="row mt-5">
                <div class="col-md-4 offset-md-8">
                    <div class="card gpa-card border-0 shadow">
                        <div class="card-body text-center p-4">
                            <p class="text-uppercase small tracking-widest mb-1 opacity-75">Semester GPA</p>
                            <h2 class="display-4 fw-bold mb-0">@gpa.ToString("F2")</h2>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">No results found for this student.</div>
        }

        <div class="mt-5 text-center d-none d-print-block">
            <div class="row">
                <div class="col-6">
                    <hr class="w-50 mx-auto" />
                    <p>Registrar Academics</p>
                </div>
                <div class="col-6">
                    <hr class="w-50 mx-auto" />
                    <p>Official Stamp</p>
                </div>
            </div>
        </div>
    </div>
</div>
